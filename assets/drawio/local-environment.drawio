instead of serving a route table nobody expected.

fail at boot, not at request time" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#0C2A1E;strokeColor=#34D399;strokeWidth=1;fontColor=#E8EEF6;fontSize=13;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="870" y="320" width="760" height="130" as="geometry"/></mxCell><mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D8B9C;strokeWidth=1.4;fontColor=#9FB0C3;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#070A0F;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="n6" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="superseded by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#34D399;strokeWidth=1.4;fontColor=#9FB0C3;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#070A0F;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="3 · RUNTIME — DOCKER COMPOSE, FIVE HOST PORTS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0A0F16;strokeColor=#1C2736;strokeWidth=1;fontColor=#9FB0C3;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1620" height="230" as="geometry"/></mxCell><mxCell id="n15" value="Entity Producer


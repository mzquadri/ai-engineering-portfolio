r=#E8EEF6;fontSize=13;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="370" width="240" height="70" as="geometry"/></mxCell><mxCell id="n22" value="ibp.events.document.extracted" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#0B2D33;strokeColor=#22D3EE;fontColor=#22D3EE;fontSize=12;fontFamily=Courier New;align=center;" vertex="1" parent="1"><mxGeometry x="880" y="375" width="300" height="30" as="geometry"/></mxCell><mxCell id="n23" value="Indexing Service" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#191C3D;strokeColor=#818CF8;strokeWidth=2;fontColor=#E8EEF6;fontSize=13;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1210" y="370" width="240" height="70" as="geometry"/></mxCell><mxCell id="n24" value="ibp.events.document.indexed" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#0B2D33;strokeColor=#22D3EE;fontColor=#22D3EE;fontSize=12;fontFamily=Courier New;align=center;" vertex="1" parent="1"><mxGeometry x="610" y="450" width="280" height="30" as="geometry"/></mxCell><mxCell id="n25" value="ibp.events.document.indexed.dlq" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#2E1416;strokeColor=#F87171;strokeWidth=1;fontColor=#E8EEF6;fontSize=13;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920" y="445" width="300" height="50" as="geometry"/></mxCell><mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#22D3EE;strokeWidth=1.4;fontColor=#9FB0C3;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#070A0F;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#22D3EE;strokeWidth=1.4;fontColor=#9FB0C3;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#070A0F;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="n20" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#22D3EE;strokeWidth=1.4;fontColor=#9FB0C3;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#070A0F;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="n21" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#22D3EE;strokeWidth=1.4;fontColor=#9FB0C3;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#070A0F;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="n22" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#22D3EE;strokeWidth=1.4;fontColor=#9FB0C3;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#070A0F;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="n23" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n31" value="failure" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F87171;strokeWidth=1.4;fontColor=#9FB0C3;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#070A0F;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="n23" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n32" value="Delivery properties that were designed, not inherited

• The Kafka key is law_key, so one law maps to one partition and two
  generations can never be processed concurrently.
• Publish, then commit: the offset is committed last of all.
• A redelivery may publish law.embedded twice; a unique index on
  capture_id absorbs it.
• A non-matching event has its offset committed and is skipped, so a
  foreign event cannot wedge the consumer." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#0C2A1E;strokeColor=#34D399;strokeWidth=2;fontColor=#E8EEF6;fontSize=13;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="760" height="180" as="geometry"/></mxCell><mxCell id="n33" value="What is missing, stated as missing

The legal pipeline has no dead-letter topic, no bounded retry and no
backoff. A permanently unprocessable law is redelivered for ever and
blocks its partition; the loop ends and waits for a human.

The document pipeline does have a DLQ. That difference is real, and it
is the clearest piece of outstanding work in the legal workstream." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#2E1416;strokeColor=#F87171;strokeWidth=2;fontColor=#E8EEF6;fontSize=13;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="830" y="540" width="730" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
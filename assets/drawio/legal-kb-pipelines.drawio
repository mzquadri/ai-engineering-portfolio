ibp.events.ai.processed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#0F2340;strokeColor=#60A5FA;strokeWidth=1;fontColor=#E8EEF6;fontSize=13;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1420" y="910" width="230" height="200" as="geometry"/></mxCell><mxCell id="n37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#818CF8;strokeWidth=1.4;fontColor=#9FB0C3;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#070A0F;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="n31" target="n32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#818CF8;strokeWidth=1.4;fontColor=#9FB0C3;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#070A0F;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="n32" target="n33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#34D399;strokeWidth=1.4;fontColor=#9FB0C3;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#070A0F;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="n33" target="n34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#818CF8;strokeWidth=1.4;fontColor=#9FB0C3;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#070A0F;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="n34" target="n35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#818CF8;strokeWidth=1.4;fontColor=#9FB0C3;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#070A0F;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="n35" target="n36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n42" value="query_points" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F0B429;strokeWidth=1.4;fontColor=#9FB0C3;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#070A0F;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=2 4;endArrow=open;" edge="1" parent="1" source="n16" target="n33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n43" value="expand" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F0B429;strokeWidth=1.4;fontColor=#9FB0C3;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#070A0F;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=2 4;endArrow=open;" edge="1" parent="1" source="n17" target="n34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n44" value="TWO PATHS, ONE CORPUS — the two pipelines share one corpus and nothing else. Every component in A writes exactly one store, and the exclusive-write
arrows are the only writes that exist; every component in B reads and returns. That is why a retrieval bug cannot corrupt the corpus and why a
question cannot start an ingest — and why B has no verification gate of its own and needs none: it trusts the corpus because A proved it first.
Not solved: no dead-letter topic on this pipeline, so one unprocessable law blocks its partition until a human intervenes; and no EU law is certified,
because the end-to-end assurance contract does not exist yet — a missing contract, not a missing parser." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#0C2A1E;strokeColor=#34D399;strokeWidth=1;fontColor=#E8EEF6;fontSize=13;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="1620" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>